# AccessScan environment — copy to .env or export before `npm start`.
# server.js reads these via process.env; all optional (defaults shown).

# Port the Express server listens on. Binds 127.0.0.1 by default;
# set HOST=0.0.0.0 only behind a reverse proxy (Caddy/nginx).
PORT=3000
HOST=127.0.0.1

# Shared secret required on every request when set (production behind
# the Vercel proxy injects it as x-proxy-key). Leave unset for local dev.
# PROXY_SECRET=

# NODE_ENV — informational only; the app doesn't branch on it.
NODE_ENV=production

# In-app rate limits (per-IP scans and global scan cap):
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_GLOBAL_MAX=60
